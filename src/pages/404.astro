---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/utils';
---
<Base lang="en" title={t('en', 'notFoundTitle')}>
  <section class="container not-found">
    <h1>{t('en', 'notFoundTitle')}</h1>
    <p class="muted" lang="fr-CA">{t('fr', 'notFoundTitle')}</p>
    <div class="links">
      <a class="btn btn-primary" href="/">{t('en', 'backHome')}</a>
      <a class="btn btn-secondary" href="/fr/" lang="fr-CA">{t('fr', 'backHome')}</a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding: var(--space-24) 0 var(--space-12);
  }
  .not-found h1 {
    margin-bottom: var(--space-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
